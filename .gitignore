# ---- Secrets (Phase 0 hardening) -------------------------------------------
# .env is already listed above; these cover the variants that actually leak.
.env.*
!.env.example
*.env
.envrc
.direnv/
secrets/
*.key
*.pem
*.p12
*.pfx
*credentials*.json
service-account*.json
.supabase/
# Never commit a raw connection string dropped into a scratch file
connection_string.txt
db_url.txt

