# Copy this file to .env and fill in all values for local development.
# NEVER commit .env to git (it is in .gitignore).

# ---------------------------------------------------------------------------
# DATABASE  (Supabase Postgres)
# ---------------------------------------------------------------------------
# Get this from: Supabase dashboard -> Connect -> Connection string
#
# USE THE **SESSION POOLER** STRING, NOT THE DIRECT CONNECTION.
#
#   Session pooler (port 5432)   IPv4 + IPv6   <-- USE THIS
#     postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-[REGION].pooler.supabase.com:5432/postgres
#
#   Direct connection (port 5432)   IPv6 ONLY on the free tier
#     postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
#
#   Transaction pooler (port 6543)  IPv4, no prepared statements, no session state
#     postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-[REGION].pooler.supabase.com:6543/postgres
#
# Why this matters: GitHub Actions runners are IPv4-only, and ARCHITECTURE_V2
# 1 puts the whole ingestion pipeline there. The direct connection would
# fail to resolve from the runner. Alembic migrations also need session mode,
# so port 6543 is wrong for them. Session pooler works for everything.
#
# Note the username differs: pooler connections use postgres.[PROJECT-REF],
# direct connections use plain postgres.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-[REGION].pooler.supabase.com:5432/postgres

# LLM provider: "groq" (gemini lands in Phase 5)
LLM_PROVIDER=groq

# Groq API (get from console.groq.com, free account, no credit card)
# Free tier: 30 RPM / 1,000 requests-per-DAY. RPD is the binding constraint.
# Model names are set in config/settings.py — do not pin deprecated ones here.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# Google Gemini (Phase 5 fallback provider — free from aistudio.google.com)
GEMINI_API_KEY=

# HuggingFace Inference API (get from huggingface.co, free account, no credit card)
# NOTE: removed entirely in Phase 2 — embeddings move to a local MiniLM in the
# GitHub Actions runner, which has no API quota. See ARCHITECTURE_V2 2.
HF_API_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx

# Environment: "development" or "production".
# In production the app refuses to start with a SQLite DATABASE_URL or
# wildcard CORS. See settings.validate_or_die().
APP_ENV=development

# CORS origins — COMMA-SEPARATED, no wildcard in production.
# A wildcard here forces credentials off (browsers reject '*' with credentials).
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000

# Optional overrides (defaults shown)
LOG_LEVEL=INFO
SIMILARITY_THRESHOLD=0.85
LLM_TEMPERATURE=0.2

# ---------------------------------------------------------------------------
# Container / Kubernetes deployment only (docs/kubernetes.md).
# The Render + Neon + GitHub Actions path does not read these.
# ---------------------------------------------------------------------------

# Password for the local/in-cluster Postgres. Read by libpq via PGPASSWORD, so
# it never has to appear inside DATABASE_URL — a leaked connection string is
# then not a leaked credential. Not used by the Neon deployment, whose password
# is part of the Neon-issued DATABASE_URL.
POSTGRES_PASSWORD=clarity

# SSL mode for PostgreSQL. "require" is correct for Neon and every hosted
# Postgres, and is the default. Set "disable" ONLY for a Postgres inside your
# own cluster or compose network, which serves no TLS and will reject the
# connection rather than downgrading.
DB_SSLMODE=require

# Enrichment worker (backend/enrichment/worker.py)
ENRICH_BATCH_SIZE=5
ENRICH_POLL_SECONDS=10
WORKER_PROBE_PORT=8082
