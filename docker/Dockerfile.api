# ClarityFeed read API.
#
#   docker build -f docker/Dockerfile.api -t clarity-api:latest .
#
# Build context is the repository root — the image needs backend/ and config/.
#
# This installs requirements-api.txt: the read API's own dependencies, not the
# pipeline's. requirements.txt is shared with ingestion and pulls in
# scikit-learn, numpy, lxml, feedparser and newspaper4k, none of which this
# process imports — and requirements-ingest.txt adds torch on top of that.
# The three lists are the difference between a ~120 MB image, a ~400 MB one
# and a ~2.5 GB one.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

WORKDIR /app

# No build toolchain. Every remaining dependency ships a manylinux wheel —
# psycopg2-binary included — so the C compiler that the pipeline's lxml and
# newspaper4k needed is not required here at all. That removes a build step, a
# purge step, and the risk of the toolchain surviving into the final image.

# Dependencies before source: editing application code reuses this layer.
COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt

COPY backend/ backend/
COPY config/ config/
COPY alembic/ alembic/
COPY alembic.ini .

RUN useradd --create-home --uid 10001 clarity && chown -R clarity:clarity /app
USER clarity

EXPOSE 8000

# Not wrapped in a shell, so uvicorn is PID 1 and receives SIGTERM directly
# for a graceful drain during a rolling update.
CMD ["uvicorn", "backend.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
